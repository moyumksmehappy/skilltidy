{
  "name": "skilltidy",
  "version": "0.2.0",
  "description": "Find the skills that stopped being true: count the commits that landed after each SKILL.md was last touched, group duplicate copies across Windows and WSL, and keep a ledger of what you already confirmed.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "skilltidy": "bin/skilltidy.js"
  },
  "main": "lib/engine.js",
  "files": [
    "bin",
    "lib",
    "ui",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "start": "node bin/skilltidy.js ui",
    "scan": "node bin/skilltidy.js scan",
    "check": "node bin/skilltidy.js check"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "skill-md",
    "claude-code",
    "codex",
    "wsl",
    "cli",
    "dashboard",
    "drift",
    "inventory",
    "maintenance",
    "audit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyumksmehappy/skilltidy.git"
  },
  "homepage": "https://github.com/moyumksmehappy/skilltidy#readme",
  "bugs": {
    "url": "https://github.com/moyumksmehappy/skilltidy/issues"
  },
  "author": "moyumksmehappy",
  "dependencies": {}
}
